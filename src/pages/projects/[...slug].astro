---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"
import { fetchGitHubReadme } from "@lib/github"

// Create the static projects pages
export async function getStaticPaths() {
	const projects = await getCollection("projects")
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: project,
	}))
}

// Get the requested project
type Props = CollectionEntry<"projects">
const project = Astro.props
const { title, summary, useGitHubReadme, repoUrl } = project.data

// Fetch GitHub README if flag is set and repoUrl exists
let githubContent = null
if (useGitHubReadme && repoUrl) {
  try {
    githubContent = await fetchGitHubReadme(repoUrl)
  } catch (error) {
    console.error('Failed to fetch GitHub README:', error)
    githubContent = null
  }
}
---

<PageLayout title={title} description={summary}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={project} />
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      {githubContent && githubContent.length > 0 ? (
        <article class="max-w-full prose prose-neutral dark:prose-invert prose-lg prose-headings:text-black prose-headings:dark:text-white">
          <div set:html={githubContent}></div>
        </article>
      ) : (
        <ArticleBottomLayout entry={project} />
      )}
    </div>
  </BottomLayout>
</PageLayout>