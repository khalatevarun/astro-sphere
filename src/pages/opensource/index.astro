---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { OPENSOURCE } from "@consts"

const collection = await getCollection("opensource")

collection.sort((a: any, b: any) => new Date(b.data.dateContributed).getTime() - new Date(a.data.dateContributed).getTime())

const opensource = await Promise.all(
  collection.map(async (item: any) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

function formatDate(input: Date | string) {
  if (typeof input === "string") return input

  const month = input.toLocaleDateString("en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={OPENSOURCE.TITLE} description={OPENSOURCE.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {OPENSOURCE.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    {opensource.length === 0 ? (
      <div class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Will fill this up soon, you can visit my GitHub 
          <a 
            href="https://github.com/khalatevarun" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-blue-600 dark:text-blue-400 hover:underline font-medium"
          >
            here
          </a>
        </p>
      </div>
    ) : (
      <ul>
        { 
          opensource.map((entry: any) => (
            <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
              <div class="text-black dark:text-white font-semibold">
                {entry.data.projectName}
              </div>
              <div class="text-sm font-semibold">
                {entry.data.contributionType}
              </div>
              {entry.data.repoUrl && (
                <div class="text-sm mb-2">
                  <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                    View Repository
                  </a>
                </div>
              )}
              <article class="prose dark:prose-invert">
                <entry.Content />
              </article>
            </li>
          ))
        }
      </ul>
    )}
    
    <!-- Other Open Source Contributions Section -->
    <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/25">
      <h2 class="text-xl font-semibold text-black dark:text-white mb-6">Other Open Source Contributions</h2>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-black dark:text-white font-medium">Helper by Antiwork</span>
          <a 
            href="https://github.com/antiwork/helper/pulls?q=is%3Apr+is%3Aclosed+author%3Akhalatevarun" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-blue-600 dark:text-blue-400 hover:underline text-sm inline-flex items-center gap-1"
          >
            View merged PRs
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-black dark:text-white font-medium">Lingo.dev</span>
          <a 
            href="https://github.com/lingodotdev/lingo.dev/pulls?q=is%3Apr+author%3Akhalatevarun+is%3Aclosed" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-blue-600 dark:text-blue-400 hover:underline text-sm inline-flex items-center gap-1"
          >
            View merged PRs
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </BottomLayout>
</PageLayout>