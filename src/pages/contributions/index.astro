---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Contributions from "@components/Contributions"
import { CONTRIBUTIONS } from "@consts"

const contributions = (await getCollection("contributions"))
  .filter(contribution => !contribution.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const tags = [...new Set(contributions.flatMap(contribution => contribution.data.tags))]
  .sort((a, b) => a.localeCompare(b))
---

<PageLayout title={CONTRIBUTIONS.TITLE} description={CONTRIBUTIONS.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {CONTRIBUTIONS.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Contributions client:load tags={tags} data={contributions} />
    </div>
  </BottomLayout>
</PageLayout>