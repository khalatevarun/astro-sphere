---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { SITE } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"
import Image from "astro/components/Image.astro"
import { formatDate } from "@lib/utils"

// Fetch featured entries (blogs + projects) server-side
const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const projects = (await getCollection("projects"))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-black hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Twinkling Stars / Metors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <script is:inline src="/js/bg.js"></script>
  
  <!-- HERO -->
  <section class="relative h-screen w-full">
    <div id="planetcont" class='animate absolute inset-0 top-1/4 overflow-hidden'>
      <div id="crescent" class='absolute top-0 left-1/2 -translate-x-1/2 w-[250vw] min-h-[100vh] aspect-square rounded-full p-[1px] bg-gradient-to-b from-black/25 dark:from-white/75 from-0% to-transparent to-5%'>
        <div id="planet" class='w-full h-full bg-white dark:bg-black rounded-full p-[1px] overflow-hidden flex justify-center'>
          <div id="blur" class='w-full h-20 rounded-full bg-neutral-900/25 dark:bg-white/25 blur-3xl'/>
        </div>
      </div>
    </div>
    <div class="animate absolute h-full w-full flex items-center justify-center">
      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold opacity-75'>
            Hello, I am
          </p>
          <p class='animated text-2xl md:text-3xl lg:text-4xl font-bold uppercase text-black dark:text-white'>
            Varun Khalate
          </p>
          <div id="ctaButtons" class='animated flex flex-wrap gap-4 justify-center mt-5'>
            <a href='/opensource' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              I contribute to open source
            </a>
            <a href='/projects' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              I build creative projects
            </a>
            <a href='/blog' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              I document my learnings
            </a>
            <a href='/work' class='py-2 px-4 truncate rounded text-xs md:text-sm lg:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend'>
              I bring professional experience
            </a>
          </div>
          <div class="flex justify-center mt-8">
            <div class="relative w-52 h-52 rounded-full overflow-hidden">
              <Image 
                src={"/images/profile_dark1.png"}
                width={500}
                height={500}
                alt="Varun Khalate B&W"
                class="absolute inset-0 w-full h-full object-cover grayscale z-10 hover:opacity-0 transition-opacity duration-300"
              />
              <Image 
                src={"/images/profile_light1.png"}
                width={500}
                height={500}
                alt="Varun Khalate Color"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED WRITINGS -->
  <section class="relative w-full max-w-4xl mx-auto px-6 -mt-12 md:-mt-20 lg:-mt-24 z-10">
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold">Featured Writings</h2>
      <p class="text-sm opacity-75 mt-1">Latest thoughts and insights from my blog.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {posts.map((entry) => (
        <a href={`/blog/${entry.slug}`} class="group p-4 gap-3 flex flex-col items-start border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
          <div class="w-full blend">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <div class="text-sm uppercase">
                  {formatDate(entry.data.date)}
              </div>
              <div class="text-sm text-right text-neutral-500">
                Post
              </div>
            </div>
            <div class="font-semibold mt-3 text-black dark:text-white">{entry.data.title}</div>
            <div class="text-sm line-clamp-2 mt-2">{entry.data.summary}</div>
            <ul class="flex flex-wrap mt-2 gap-1">
              {(entry.data.tags as string[] | undefined)?.map((tag) => (
                <li class="text-xs uppercase py-0.5 px-1 rounded bg-black/5 dark:bg-white/20 text-black/75 dark:text-white/75">{tag}</li>
              ))}
            </ul>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white ml-auto mt-3">
            <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
            <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
          </svg>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/blog" class="inline-flex items-center gap-2 py-2 px-6 rounded-full border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 transition-colors duration-300 text-sm font-medium">
        See All Writings
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-current">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="relative w-full max-w-4xl mx-auto px-6 mt-16 z-10">
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold">Featured Projects</h2>
      <p class="text-sm opacity-75 mt-1">Creative solutions and technical implementations.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((entry) => (
        <a href={`/projects/${entry.slug}`} class="group p-4 gap-3 flex flex-col items-start border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
          <div class="w-full blend">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <div class="text-sm uppercase">
                  {formatDate(entry.data.date)}
              </div>
              <div class="text-sm text-right text-neutral-500">
                Project
              </div>
            </div>
            <div class="font-semibold mt-3 text-black dark:text-white">{entry.data.title}</div>
            <div class="text-sm line-clamp-2 mt-2">{entry.data.summary}</div>
            <ul class="flex flex-wrap mt-2 gap-1">
              {(entry.data.tags as string[] | undefined)?.map((tag) => (
                <li class="text-xs uppercase py-0.5 px-1 rounded bg-black/5 dark:bg-white/20 text-black/75 dark:text-white/75">{tag}</li>
              ))}
            </ul>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white ml-auto mt-3">
            <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
            <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
          </svg>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/projects" class="inline-flex items-center gap-2 py-2 px-6 rounded-full border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 transition-colors duration-300 text-sm font-medium">
        See All Projects
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stroke-current">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>
  </section>
</PageLayout>
